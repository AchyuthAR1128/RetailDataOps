# =============================================================================
# RetailDataOps — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# All app-specific variables are prefixed with RETAILDATAOPS_ to avoid
# collisions with system environment variables.
# =============================================================================

# -- Application --------------------------------------------------------------
RETAILDATAOPS_APP_NAME=RetailDataOps
RETAILDATAOPS_APP_ENV=development          # development | staging | production
RETAILDATAOPS_DEBUG=false
RETAILDATAOPS_LOG_LEVEL=INFO

# -- Database (future phases) -------------------------------------------------
# RETAILDATAOPS_DATABASE_URL=postgresql://user:password@localhost:5432/retaildataops

# -- Snowflake (future phases) ------------------------------------------------
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_ROLE=

# -- Cloud Storage (future phases) --------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=
